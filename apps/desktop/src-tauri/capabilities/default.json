{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de la ventana principal de Orbit",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-orbit-snapshot",
    "allow-orbit-read-sessions-page",
    "allow-orbit-read-session-messages",
    "allow-orbit-agent",
    "allow-orbit-send",
    "allow-orbit-report",
    "allow-orbit-attachment-add",
    "allow-orbit-attachment-content",
    "allow-orbit-attachment-open",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        }
      ]
    }
  ]
}
