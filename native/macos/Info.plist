<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>NSCalendarsFullAccessUsageDescription</key><string>Orbit needs full access to your calendars to read your events and to create, move, edit and delete the events you change in Orbit.</string>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key><array><string>en</string><string>es</string></array>
  <key>CFBundleIdentifier</key><string>app.orbit.companion</string>
  <key>CFBundleName</key><string>Orbit</string>
  <key>CFBundleDisplayName</key><string>Orbit</string>
  <key>CFBundleExecutable</key><string>Orbit</string>
  <key>CFBundleIconFile</key><string>icon.icns</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.12.9</string>
  <key>CFBundleVersion</key><string>2</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <!-- The daemon runs in this process: macOS must never nap it, since it
       records, uploads and keeps the helper's heartbeat in the background. -->
  <key>NSAppSleepDisabled</key><true/>
  <key>NSMicrophoneUsageDescription</key><string>Orbit uses the microphone only when you start a conversation or authorize a recording.</string>
  <key>NSAudioCaptureUsageDescription</key><string>Orbit captures audio from the application you authorize to preserve your meeting.</string>
  <key>NSScreenCaptureUsageDescription</key><string>Orbit views the screen only during an active call or when you ask it to.</string>
</dict></plist>
