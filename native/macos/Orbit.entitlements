<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- The hardened runtime denies protected resources to a process that does not
       declare them, and an EventKit request denied this way returns with no
       dialog at all: exactly what "no me aparece ningun dialog" looks like.
       The microphone worked throughout because its entitlement was here from the
       start; the calendar's never was. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict></plist>
